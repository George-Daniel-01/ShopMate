# Copy this file to ./config/config.env and fill in the values.
# The real values live in the Vercel dashboard:
#   vercel link --project shop-mate-backend --yes
#   vercel env pull --environment=production
# (see OPERATIONS.md at the repo root)

DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.eu-west-2.aws.neon.tech/shopmate?sslmode=require
JWT_SECRET_KEY=change_me
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7

CLOUDINARY_CLIENT_NAME=
CLOUDINARY_CLIENT_API=
CLOUDINARY_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FRONTEND_KEY=

SMTP_HOST=
SMTP_MAIL=
SMTP_PASSWORD=
SMTP_SERVICE=
SMTP_PORT=

ADMIN_SECRET_KEY=change_me
OPENROUTER_API_KEY=
GEMINI_API_KEY=

FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
PORT=4000
